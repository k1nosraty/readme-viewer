# Superdesign temporary artifacts (component templates, fetched draft HTML)
.superdesign/tmp/

# Test dependencies (the app itself has no build step)
node_modules/

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs and local scratch
*.log
npm-debug.log*
scratch/
tmp/

# NOTE: vendor/ is intentionally tracked — the app runs offline from file://
#       and needs its libraries committed.

# Release build output
dist/

# Android generated files
android/.gradle/
android/**/build/
android/app/src/main/assets/
android/local.properties

# Tauri build outputs (native shell sources and Cargo.lock are tracked)
native-dist/
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/**/build/
src-tauri/gen/android/local.properties
src-tauri/gen/android/.idea/
