{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "README Viewer",
  "version": "2.0.0",
  "identifier": "io.github.readmeviewer.viewer",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "npm run native:prepare",
    "beforeBuildCommand": "npm run native:prepare",
    "frontendDist": "../native-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "README Viewer",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": [
        "main",
        "desktop-titlebar",
        "android-back",
        "updater"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Offline Markdown, code and configuration viewer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGMjBGRERDOUI3Njk4RDMKUldUVG1IYWIzUDBnMzVUYndzRjllV2FZL2F2VkVraGR6MnVYS1A0MlkyZXRGRVJCcURQUUlQR04K",
      "endpoints": [
        "https://github.com/k1nosraty/readme-viewer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
